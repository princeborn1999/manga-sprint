{
  "name": "mangasprint",
  "description": "Local Windows manga production progress tracker",
  "author": "MangaSprint",
  "private": true,
  "version": "0.1.0",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "dist:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.mangasprint.desktop",
    "productName": "MangaSprint",
    "artifactName": "MangaSprint-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {"output":"release"},
    "files": ["out/**/*","package.json"],
    "win": {"target":[{"target":"nsis","arch":["x64"]}],"signAndEditExecutable":false,"signExecutable":false},
    "nsis": {"script":"build/installer.nsi","oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"deleteAppDataOnUninstall":false}
  }
}
